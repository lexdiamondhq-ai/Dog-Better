EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# RevenueCat public SDK key for iOS (starts with appl_). Public by design; it is safe in the bundle.
# Without it the app runs, Premium is unavailable, and the paywall says so. Expo Go never has StoreKit.
# Local Metro reads this file. EAS store builds do not. After Apple is Active and RevenueCat has the
# iOS app, set the same key on the EAS project (do not put an empty value in eas.json):
#   eas env:create --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value appl_... --environment production --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value appl_... --environment preview --visibility plaintext
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Android only: react-native-maps needs a Maps SDK for Android key. iOS uses Apple Maps and needs nothing.
# Injected into android.config.googleMaps.apiKey by app.config.ts. Not EXPO_PUBLIC_ on purpose: it never ships in the JS bundle.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional, development only: shows a "skip to the QA account" link on the welcome screen in dev builds.
# Compiled out of release builds, and eas.json clears both for every EAS build. Leave empty anywhere shared.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=

# Server secrets live in Supabase, never here:
#   supabase secrets set OPENAI_API_KEY=sk-...            (ai Edge Function; Look and the visit sheet reader)
#   supabase secrets set REVENUECAT_WEBHOOK_SECRET=...    (revenuecat-webhook Edge Function)
