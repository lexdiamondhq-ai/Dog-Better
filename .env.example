EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Android only: react-native-maps needs a Maps SDK for Android key. iOS uses Apple Maps and needs nothing.
# Injected into android.config.googleMaps.apiKey by app.config.ts. Not EXPO_PUBLIC_ on purpose: it never ships in the JS bundle.
GOOGLE_MAPS_ANDROID_API_KEY=
