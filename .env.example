EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Android only: react-native-maps needs a Maps SDK for Android key. iOS uses Apple Maps and needs nothing.
# Injected into android.config.googleMaps.apiKey by app.config.ts. Not EXPO_PUBLIC_ on purpose: it never ships in the JS bundle.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional, development only: shows a "skip to the QA account" link on the welcome screen in dev builds.
# Compiled out of release builds. Leave empty in any shared or production environment.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=

# Optional. If set, Look (Community orb) sends the photo to OpenAI vision. Leave empty to use the local checklist.
EXPO_PUBLIC_OPENAI_API_KEY=
