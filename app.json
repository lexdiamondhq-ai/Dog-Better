{
  "expo": {
    "name": "Dog Better",
    "slug": "dog-better",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dogbetter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.dogbetter.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.dogbetter.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": { "backgroundColor": "#171210" }
        }
      ],
      [
        "expo-audio",
        { "microphonePermission": "Dog Better listens to your dog's barks for a few seconds to estimate their mood. Audio is analysed on your phone and never uploaded." }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dog Better uses the camera to scan treat barcodes and take photos for your dog's vault.",
          "microphonePermission": "Dog Better uses the microphone to translate barks.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Dog Better needs your photos so you can pick pictures of your dog for their profile, vault, and the pack." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Dog Better uses your location to find dog parks, trails, and patios nearby." }
      ],
      "./plugins/withSpaceSafePods.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
