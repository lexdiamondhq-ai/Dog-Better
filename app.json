{
  "expo": {
    "name": "Dog Better",
    "slug": "dog-better",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dogbetter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.dogbetter.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.dogbetter.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": { "backgroundColor": "#171210" }
        }
      ],
      "expo-apple-authentication",
      "expo-video",
      ["expo-sensors", { "motionPermission": "Dog Better counts your steps during walks so you can see how much you and your dog moved together." }],
      [
        "expo-camera",
        {
          "cameraPermission": "Dog Better uses the camera to scan treat barcodes, scan documents, and take photos and videos of symptoms for your dog's records.",
          "microphonePermission": "Dog Better uses the microphone when you record a short video of a behaviour or symptom.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Dog Better needs your photos and videos so you can pick pictures of your dog and post short Barks." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Dog Better uses your location to show the walk map, and to find nearby vets, dog parks, trails, and patios." }
      ],
      "./plugins/withSpaceSafePods.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
